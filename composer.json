{
    "name": "ai-soft-jp/cake-error-reporter",
    "description": "ErrorReporter for CakePHP",
    "keywords": ["cakephp"],
    "type": "cakephp-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=7.3.0",
        "cakephp/cakephp": "^4.0"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "*"
    },
    "autoload": {
        "psr-4": {
            "ErrorReporter\\": "src/"
        }
    },
    "scripts": {
        "check": ["@cs-check"],
        "cs-check": "phpcs --colors -p src/",
        "cs-fix": "phpcbf --colors -p src/"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
